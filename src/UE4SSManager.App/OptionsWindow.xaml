<Window x:Class="UE4SSManager.App.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="620" Height="600" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90"/>
            <Button Content="Save" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSave" Margin="8,0,0,0" MinWidth="90"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionBar}">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="LIBRARY FOLDERS"/>
                </Border>
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                   Text="Every sub-folder of these is checked for Unreal Engine games, e.g. E:\GOG. Steam, GOG Galaxy and Epic installs are found on their own."/>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Height="110" Background="{StaticResource AppBg}">
                            <ListBox x:Name="Folders"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add folder..." Click="OnAddFolder"/>
                            <Button Content="Remove" Click="OnRemoveFolder" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBar}" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="HIDDEN GAMES"/>
                </Border>
                <Border Style="{StaticResource Group}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Show all again" Click="OnUnhide"/>
                        <TextBlock x:Name="HiddenText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SectionBar}" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="INSTALLING"/>
                </Border>
                <Border Style="{StaticResource Group}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" Text="Release repository" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="Repo" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Grid.Row="2" Text="GitHub token" Style="{StaticResource FieldLabel}" Margin="0,12,12,0"/>
                        <TextBox x:Name="Token" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,6,0,0" FontSize="11"
                                   Text="Optional. Without a token GitHub allows 60 release lookups an hour, which is plenty unless you share an IP. A token with no scopes is enough."/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionBar}" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="FILES"/>
                </Border>
                <Border Style="{StaticResource Group}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open downloads and backups" Click="OnOpenCache"/>
                        <Button Content="Open settings folder" Click="OnOpenSettings" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
